@model IEnumerable<ChessWebsite.Models.Tournament>
@{
    ViewData["Title"] = "Tournaments - ChessMasters";
}

<div class="tournaments-container">
    <!-- Header Section -->
    <div class="tournaments-header">
        <div class="header-content">
            <h1><i class="fas fa-trophy"></i> Chess Tournaments</h1>
            <p>Join competitive tournaments and test your skills against players from around the world</p>
        </div>
        <div class="header-actions">
            <a asp-action="Create" class="btn-admin">
                <i class="fas fa-plus"></i> Create Tournament
            </a>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="filters-section">
        <form method="get" class="filters-form">
            <div class="search-box">
                <input type="text" name="search" placeholder="Search tournaments..." value="@ViewBag.Search" />
                <button type="submit"><i class="fas fa-search"></i></button>
            </div>

            <div class="filter-controls">
                <select name="status" onchange="this.form.submit()">
                    <option value="">All Status</option>
                    @foreach (var status in Enum.GetValues(typeof(ChessWebsite.Models.TournamentStatus)))
                    {
                        <option value="@status" selected="@(ViewBag.Status == status.ToString())">
                            @(((ChessWebsite.Models.TournamentStatus)status).ToString())
                        </option>
                    }
                </select>

                <select name="type" onchange="this.form.submit()">
                    <option value="">All Types</option>
                    @foreach (var type in Enum.GetValues(typeof(ChessWebsite.Models.TournamentType)))
                    {
                        <option value="@type" selected="@(ViewBag.Type == type.ToString())">
                            @(((ChessWebsite.Models.TournamentType)type).ToString())
                        </option>
                    }
                </select>

                <a asp-action="Index" class="btn-clear">Clear Filters</a>
            </div>
        </form>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- Tournaments Grid -->
    @if (!Model.Any())
    {
        <div class="no-tournaments">
            <i class="fas fa-chess-board"></i>
            <h3>No tournaments found</h3>
            <p>Check back later or create a new tournament</p>
        </div>
    }
    else
    {
        <div class="tournaments-grid">
            @foreach (var tournament in Model)
            {
                <div class="tournament-card">
                    <div class="tournament-header">
                        <div class="tournament-type @tournament.Type.ToString().ToLower()">
                            <i class="fas fa-chess-king"></i>
                            <span>@tournament.Type</span>
                        </div>
                        <div class="tournament-status @tournament.Status.ToString().ToLower()">
                            @tournament.Status
                        </div>
                    </div>

                    <div class="tournament-body">
                        <h3>@tournament.Name</h3>
                        <p class="tournament-description">@tournament.Description</p>

                        <div class="tournament-details">
                            <div class="detail-item">
                                <i class="fas fa-calendar-alt"></i>
                                <span>@tournament.StartDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-clock"></i>
                                <span>@tournament.StartDate.ToString("hh:mm tt")</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>@tournament.Location</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-users"></i>
                                <span>@tournament.CurrentParticipants/@tournament.MaxParticipants players</span>
                            </div>
                        </div>

                        <!-- Prize Pool Display - Shows total regardless of distribution method -->
                        @if (tournament.DisplayPrizePool > 0)
                        {
                            <div class="tournament-prize">
                                <i class="fas fa-award"></i>
                                <span>Prize Pool: ₱@tournament.DisplayPrizePool.ToString("N0")</span>
                            </div>
                        }
                        else
                        {
                            <div class="tournament-prize no-prize">
                                <i class="fas fa-gift"></i>
                                <span>No prize pool specified</span>
                            </div>
                        }

                        <div class="tournament-footer">
                            <div class="tournament-fee">
                                <span class="fee-label">Entry Fee:</span>
                                <span class="fee-amount">₱@tournament.EntryFee.ToString("N2")</span>
                            </div>
                            <div class="tournament-actions">
                                <a asp-action="Details" asp-route-id="@tournament.TournamentId" class="btn-view">
                                    <i class="fas fa-eye"></i> View
                                </a>
                                @if (tournament.Status == ChessWebsite.Models.TournamentStatus.RegistrationOpen
                                                        && tournament.CurrentParticipants < tournament.MaxParticipants)
                                {
                                    <form asp-action="Register" asp-route-id="@tournament.TournamentId" method="post">
                                        <button type="submit" class="btn-register">
                                            <i class="fas fa-user-plus"></i> Register
                                        </button>
                                    </form>
                                }
                                <div class="admin-actions">
                                    <a asp-action="Edit" asp-route-id="@tournament.TournamentId" class="btn-edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@tournament.TournamentId" method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this tournament?');">
                                        <button type="submit" class="btn-delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="pagination">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@ViewBag.Search"
                       asp-route-status="@ViewBag.Status"
                       asp-route-type="@ViewBag.Type"
                       class="@(i == ViewBag.CurrentPage ? "active" : "")">@i</a>
                }
            </div>
        }
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/tournament.css" asp-append-version="true" />
}