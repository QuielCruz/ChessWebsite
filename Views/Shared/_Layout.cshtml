<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chess Website</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <i class="fas fa-chess-king"></i>
                <h1>Chess<span>Masters</span></h1>
            </div>
            <ul class="nav-menu">
                <!-- Modified Home link to show Admin Panel for admins -->
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <li><a asp-area="" asp-controller="Home" asp-action="AdminPanel" class="active">Home</a></li>
                }
                else
                {
                    <li><a asp-area="" asp-controller="Home" asp-action="Index" class="active">Home</a></li>
                }
                <li><a asp-area="" asp-controller="Tournament" asp-action="Index">Chess Events</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Recognition">Recognition</a></li>

                <li>
                    @if (User.Identity.IsAuthenticated || ViewBag.IsLoggedIn == true)
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn-logout">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn-login">
                            <i class="fas fa-sign-in-alt"></i> Admin Login
                        </a>
                    }
                </li>
            </ul>

            <div class="mobile-menu-btn">
                <i class="fas fa-bars"></i>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                    <i class="fas fa-chess-king"></i>
                    <h2>Chess<span>Masters</span></h2>
                    <p>Where strategy meets community</p>
                </div>
                <div class="footer-links">
                    <div class="footer-column">
                        <h3>Platform</h3>
                        <a asp-area="" asp-controller="Tournament" asp-action="Index">Tournaments</a>
                        <a href="#">About Us</a>
                    </div>
                    <div class="footer-column">
                        <h3>Community</h3>
                        <a href="#">Blog</a>
                        <a href="#">Events</a>
                    </div>
                    <div class="footer-column">
                        <h3>Support</h3>
                        <a href="#">Help Center</a>
                        <a asp-area="" asp-controller="Account" asp-action="Login">Admin Login</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year ChessMasters. All rights reserved.</p>
                <div class="social-icons">
                    <a href="#"><i class="fab fa-facebook"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/js/script.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>